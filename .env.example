# Copy this file to .env.local for local development, or add these as
# Environment Variables in your hosting provider's dashboard (e.g. Vercel)
# for production. Never commit a file containing real values.

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (use the "URI" / direct connection string, not the pooled one, unless you
# know you need pooling). Looks like:
# postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Supabase Storage (admin image uploads, commission reference images) ---
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=
# The SERVICE ROLE key (not the anon/public key). Server-only, full access —
# never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin authentication ----------------------------------------------------
# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
# (or any long random string, at least 32 characters).
ADMIN_SESSION_SECRET=

# --- Site URL -----------------------------------------------------------------
# The public URL this site is deployed at (no trailing slash). Used to build
# PayFast return/cancel/notify URLs and absolute links in emails.
# Local dev:  http://localhost:3000
# Production: https://www.yourdomain.co.za
NEXT_PUBLIC_SITE_URL=

# --- PayFast payment gateway --------------------------------------------------
# https://developers.payfast.co.za — get these from your PayFast (or Sandbox)
# merchant dashboard: Settings -> Integration.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Required before going live; set under Settings -> Salt Passphrase.
PAYFAST_PASSPHRASE=
# "true" while testing against sandbox.payfast.co.za, "false" once you have
# real (live) merchant credentials and are ready to accept real payments.
PAYFAST_SANDBOX=true

# Separate from PAYFAST_SANDBOX above. Controls whether the site tells real
# visitors that live payment is available at all. Leave "false" (or unset)
# until you've: added Des's real PAYFAST_MERCHANT_ID/KEY/PASSPHRASE, set
# PAYFAST_SANDBOX=false, and successfully tested a real payment. While false,
# "Acquire This Artwork" reads "Request to Purchase" and reserves the piece
# without sending anyone to PayFast — Des follows up directly to arrange
# payment. Flip to "true" only once real payment has been tested end-to-end.
PAYFAST_LIVE=false

# --- Transactional email (Resend) --------------------------------------------
# https://resend.com — used to email Des about new enquiries/commissions and
# to send customers their shipping-quote payment link. Optional: if left
# blank, form submissions are still saved to the database, just not emailed.
RESEND_API_KEY=
# Must be a verified sender on your Resend account/domain.
RESEND_FROM_EMAIL="Art by Des Green <hello@yourdomain.co.za>"
# Where new enquiry/commission/shipping-quote notifications are sent.
CONTACT_NOTIFICATION_EMAIL=djuta68@gmail.com

# --- Meta Pixel (Facebook/Instagram ad tracking) ------------------------------
# Meta Events Manager -> Data Sources -> your Pixel -> Settings, or
# Business Settings -> Data Sources -> Pixels. A string of digits.
# Public by design (NEXT_PUBLIC_ prefix — Meta Pixel is a client-side script).
# Leave blank to keep the pixel fully disabled; the site never claims tracking
# is active unless this is set.
NEXT_PUBLIC_META_PIXEL_ID=
